<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.32.1" />
		<PackageReference Include="Grpc.Core" Version="2.46.6" />
		<PackageReference Include="Grpc.Tools" Version="2.72.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Structure.proto" GrpcServices="None" />
		<Protobuf Include="FileSystem/Directory.proto" GrpcServices="Both" />
		<Protobuf Include="Providers/Providers.proto" GrpcServices="None"/>
		<Protobuf Include="Providers/ProviderService.proto" GrpcServices="Both"/>
	</ItemGroup>

</Project>